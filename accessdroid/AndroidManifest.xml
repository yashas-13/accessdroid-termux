<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.accessdroid.termux"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Required for AccessibilityService -->
    <permission
        android:name="com.accessdroid.termux.permission.BIND_ACCESSIBILITY_SERVICE"
        android:protectionLevel="signature"/>

    <uses-permission android:name="com.accessdroid.termux.permission.BIND_ACCESSIBILITY_SERVICE"/>
    <!-- Optional: needed if we want to auto-start after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Optional: to control volume/some system settings -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <!-- The AccessibilityService component -->
        <service
            android:name=".AccessibilityServiceImpl"
            android:exported="false"
            android:permission="com.accessdroid.termux.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>

            <!-- Service meta-data -->
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

    </application>
</manifest>